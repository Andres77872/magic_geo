# magic-geo Docker Compose configuration.
#
# Copy this file to `.env` and adjust the values. Docker Compose reads `.env`
# automatically for `${...}` substitution. The Compose file injects only the
# runtime variables consumed by the container; host paths and build
# settings remain Compose-only.
#
# This template is Docker-oriented. For a bare-metal server, use the CLI
# defaults or set MAGIC_GEO_WORKSPACE (for example, `runs`),
# MAGIC_GEO_HOST (normally `127.0.0.1`), and MAGIC_GEO_PORT directly.

# ---------------------------------------------------------------------------
# World storage
# ---------------------------------------------------------------------------

# Host directory where generated worlds, configs, reports, and exports are
# persisted. Docker Compose bind-mounts it into the container workspace, so
# worlds survive container rebuilds. Relative paths resolve against the
# Compose project directory (normally the repository root).
MAGIC_GEO_WORLDS_DIR=./worlds

# Absolute workspace path inside the container. Compose mounts the host worlds
# directory here and passes the same value to the process as
# MAGIC_GEO_WORKSPACE. It can be outside the container project root `/app`.
# Keeping this distinct from MAGIC_GEO_WORKSPACE prevents a bare-metal value
# such as `runs` from becoming an invalid relative container mount target.
MAGIC_GEO_CONTAINER_WORKSPACE=/app/runs

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Address the server binds to *inside* the container/process. 0.0.0.0 is
# required in Docker so the published port can reach it; use 127.0.0.1 for a
# bare-metal run unless a trusted network boundary protects the workbench.
MAGIC_GEO_HOST=0.0.0.0

# Port the web workbench listens on (and the port Compose publishes).
MAGIC_GEO_PORT=8642

# Host interface Docker publishes the workbench on. The workbench has no
# authentication, so the default only exposes it to the local machine. Set to
# 0.0.0.0 only behind a trusted network boundary or authenticating proxy.
MAGIC_GEO_PUBLISH_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Image build
# ---------------------------------------------------------------------------

# Python slim-image version used by both Dockerfile stages. Changing any value
# in this section requires `docker compose build` or `up --build`.
MAGIC_GEO_PYTHON_VERSION=3.13

# UID/GID assigned to the unprivileged `magicgeo` container user. The defaults
# match the first regular Linux user. If your host uses different IDs, set
# these to the output of `id -u` and `id -g` before building.
MAGIC_GEO_APP_UID=1000
MAGIC_GEO_APP_GID=1000

# Build the native CUDA backend into the image (requires editing the builder
# stage to a CUDA base image; see docs/docker_deployment.md). OFF builds the
# portable CPU/OpenMP core with a CUDA runtime stub.
MAGIC_GEO_ENABLE_CUDA=OFF

# ---------------------------------------------------------------------------
# Optional runtime override
# ---------------------------------------------------------------------------

# Override the native shared library the Python layer loads through ctypes.
# Leave empty for the wheel-bundled library. A non-empty container path also
# needs an explicit bind mount added to docker-compose.yml.
MAGIC_GEO_NATIVE_LIBRARY=

# Storage paths used by both the CLI and browser. Blank means the repository
# default. Relative values resolve against the project root. In Docker these
# are CONTAINER paths; use a mounted directory to retain writes on the host.
# Bare-metal usage: export the settings in your shell or service environment.
# See docs/runtime_storage.md for defaults, discovery order and examples.
MAGIC_GEO_CONFIG_PATH=
MAGIC_GEO_CONFIG_DIR=
MAGIC_GEO_SAVED_CONFIG_DIR=
MAGIC_GEO_OUTPUT_DIR=
MAGIC_GEO_DEBUG_DIR=
MAGIC_GEO_REPORTS_DIR=
MAGIC_GEO_EXPORTS_DIR=
MAGIC_GEO_STATE_DIR=
MAGIC_GEO_CALIBRATION_DIR=
MAGIC_GEO_PROJECT_ROOT=
