include CMakeLists.txt
include README.md
include pyproject.toml
include setup.py
recursive-include cpp *.cpp *.cu *.hpp *.md
recursive-include configs *.json *.yaml
recursive-include docs *.md
recursive-include scripts *.mjs *.py
recursive-include src/magic_geo *.css *.html *.js *.py *.yaml
recursive-include tests *.py
global-exclude *.dll *.dylib *.so
global-exclude *.py[cod]
global-exclude __pycache__
prune build
prune cmake-build-debug
prune runs
